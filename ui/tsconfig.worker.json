{
  // tsconfig.worker.json
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "dist/cron",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./cron/*"]
    }
  },
  "include": ["cron/**/*.ts"],
  "exclude": ["cron/**/*.test.ts"]
}
