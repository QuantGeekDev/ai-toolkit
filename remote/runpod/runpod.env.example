# Controller-only. Never place these in a job, bundle, browser request, or worker template.
AI_TOOLKIT_RUNPOD_ENABLED=1
RUNPOD_API_KEY=replace-with-a-new-rotated-key
RUNPOD_S3_ACCESS_ID=replace-with-network-volume-s3-access-id
RUNPOD_S3_SECRET=replace-with-network-volume-s3-secret

# These can instead be saved through AI Toolkit Settings.
RUNPOD_ENDPOINT_ID=replace-with-endpoint-id
RUNPOD_NETWORK_VOLUME_ID=replace-with-volume-id
RUNPOD_S3_ENDPOINT=https://s3api-REGION.runpod.io
RUNPOD_S3_REGION=EU-RO-1
RUNPOD_S3_BUCKET=replace-with-volume-id
RUNPOD_WORKER_IMAGE_DIGEST=registry.example/ai-toolkit@sha256:replace-with-real-digest
RUNPOD_MAX_CONCURRENT_JOBS=1
RUNPOD_EXECUTION_TIMEOUT_MS=10800000
RUNPOD_TTL_MS=21600000

# Worker-template secrets/environment. The worker must not receive RUNPOD_API_KEY or S3 credentials.
# HF_TOKEN=replace-with-read-only-hugging-face-token
# AITK_WORKER_IMAGE_DIGEST=registry.example/ai-toolkit@sha256:replace-with-the-same-real-digest
# AITK_REQUIRE_H100=1

# Optional local-controller archive. Standard AWS credential resolution remains local.
# AI_TOOLKIT_AWS_ARCHIVE_ENABLED=1
# AWS_PROFILE=echoflicks
# AWS_ARCHIVE_BUCKET=replace-with-private-bucket
# AWS_ARCHIVE_REGION=eu-west-1
# AWS_ARCHIVE_PREFIX=ai-toolkit
